# Dhan API credentials (from https://dhanhq.co/app/profile)
DHAN_ACCESS_TOKEN=your_dhan_access_token_here
DHAN_CLIENT_ID=your_dhan_client_id_here

# Neon PostgreSQL connection string (from https://console.neon.tech)
# Format: postgresql://user:pass@ep-xxx.region.aws.neon.tech/nifty_paper?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/nifty_paper?sslmode=require

# Email notifications via Resend (from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx
NOTIFY_EMAIL=anmol@turings.xyz
